{
  "manifest_version": 3,
  "name": "SAGE UI Fixes",
  "version": "2.5.6",
  "description": "Client UI fixes for sage.staratlas.com 0.0.371 (map, combat, builder, ownership). LEEKS / Produce Bandit ltd",
  "author": "LEEKS",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://sage.staratlas.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cors_assets",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://sage.staratlas.com/*"
      ],
      "js": [
        "patches.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://sage.staratlas.com/*"
      ],
      "js": [
        "hud/css-fixes.js",
        "hud/ops-log.js",
        "hud/combat-resolve.js",
        "hud/craft-jump.js",
        "hud/fleet-bar.js",
        "hud/fleet-ops.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "SAGE UI Fixes",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  }
}
